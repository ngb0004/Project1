# Supabase project the console signs the owner into. Use the ANON (publishable)
# key: the console acts as the signed-in admin, so row-level security and the
# database's review actions decide everything. A service-role key is refused.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public origin of the dive app, for transparency-page and share links.
NEXT_PUBLIC_DIVE_APP_URL=
