# Build-time settings for the dive app. Copy to .env (or set them in the EAS
# build profile). Expo inlines EXPO_PUBLIC_* values when it bundles, so restart
# Metro with --clear after changing one.

# The Supabase project that serves published dives (anon key only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required for iOS and Android release builds: the https origin of the public
# web app, e.g. https://dive.example. Share cards and share text link to
# <origin>/s/<slug>, a page that gives link previews a title, text and image
# and then opens <origin>/case/<slug>, which recipients without the app can open. When it is
# unset, native builds leave the link off the card (a dive:// link only works
# where the app is installed, and messengers do not make it tappable). The web
# build falls back to its own origin.
EXPO_PUBLIC_SHARE_BASE_URL=

# Optional: the app's store pages. When set, the website shows a small
# "Get the app" banner (App Store on iPhone and iPad, Google Play on Android,
# both elsewhere). Leave empty until the app is in the stores.
EXPO_PUBLIC_IOS_APP_STORE_URL=
EXPO_PUBLIC_ANDROID_PLAY_URL=

# Optional, for demos without Supabase: a URL serving a JSON array of
# { doc, seedProfile? } where each doc is a case's public projection
# (toPublicCase from @sia/case-schema). Full case documents are rejected.
EXPO_PUBLIC_DEMO_CASES_URL=
