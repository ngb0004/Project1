{
  "expo": {
    "name": "Dive",
    "slug": "dive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dive-icon.png",
    "scheme": "dive",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ngb0004.dive"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/images/dive-adaptive-foreground.png",
        "backgroundImage": "./assets/images/dive-adaptive-background.png",
        "monochromeImage": "./assets/images/dive-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ngb0004.dive"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/dive-favicon.png",
      "name": "Dive",
      "backgroundColor": "#F6F2EA",
      "themeColor": "#F6F2EA"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EA",
          "image": "./assets/images/dive-splash.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eab1022a-9b1c-493a-ad34-c35ec1a44f79"
      }
    },
    "owner": "ngb0004"
  }
}
