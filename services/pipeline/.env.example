# Pipeline worker (`pipeline worker`). Copy to pipeline.env for `docker run --env-file`,
# or export in the shell. See README.md for what each one does.

# The Supabase project. The ANON (publishable) key: the worker signs in as the
# pipeline account, and row-level security decides what it may write. Never put
# the service-role key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# The pipeline account (app_metadata.app_role = pipeline), created once with
# supabase/scripts/create-staff-user.ts --role pipeline.
PIPELINE_EMAIL=
PIPELINE_PASSWORD=

# Claude access for the Agent SDK, e.g. an API key.
ANTHROPIC_API_KEY=

# Optional (defaults shown).
# PIPELINE_WORKER_ID=<hostname>:<pid>
# PIPELINE_POLL_SECONDS=30
# PIPELINE_HEARTBEAT_SECONDS=60
# PIPELINE_SHUTDOWN_GRACE_SECONDS=10
# PIPELINE_BUDGET_USD=40
# PIPELINE_MAX_ROUNDS=3
# PIPELINE_MODEL_STRONG=claude-opus-5-5
# PIPELINE_MODEL_FAST=claude-sonnet-5-5
# PIPELINE_HEALTH_FILE=
