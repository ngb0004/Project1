{
  "name": "@sia/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent research pipeline: researches a case, drafts the dive, attacks its own draft, and submits a package for review.",
  "bin": {
    "pipeline": "./src/cli.ts"
  },
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "worker": "tsx src/cli.ts worker",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@anthropic-ai/sdk": "0.132.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "@sia/case-schema": "workspace:*",
    "@sia/case-store": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "linkedom": "0.18.13",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  }
}
